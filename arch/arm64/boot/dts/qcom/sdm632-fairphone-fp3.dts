// SPDX-License-Identifier: BSD-3-Clause
/*
 * Copyright (c) 2022, Luca Weiss <luca@z3ntu.xyz>
 * Copyright (c) 2026, Marc Lainez <marc.lainez@gmail.com>
 *
 * Device tree for the Fairphone 3 and Fairphone 3+.
 *
 * There is one mainboard.  Both models report qcom,msm-id = <349 0> and
 * qcom,board-id = <8 0x10000>, and the parts that differ between them —
 * the rear camera, the front camera and the loudspeaker — are sold as
 * user-installable modules, so a given phone can carry any mix of the
 * two generations:
 *
 *	slot		Fairphone 3		Fairphone 3+
 *	rear camera	Sony IMX363		Samsung S5KGM1SP
 *	front camera	Samsung S5K4H7YX	Samsung S5K3P9SP
 *	loudspeaker	Awinic AW8898		TI TAS2557
 *
 * This file therefore describes the slots rather than their contents.
 * drivers/misc/fp3_module_slot.c identifies what is fitted at boot and
 * applies the matching device tree overlay, which is what brings up
 * CAMSS and the sound card — both deliberately left disabled here.
 */
/dts-v1/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
#include <dt-bindings/sound/qcom,wcd9335.h>
#include "sdm632.dtsi"
#include "pm8953.dtsi"
#include "pmi632.dtsi"

/ {
	model = "Fairphone 3";
	compatible = "fairphone,fp3", "qcom,sdm632";
	chassis-type = "handset";
	qcom,msm-id = <349 0>;
	qcom,board-id = <8 0x10000>;

	aliases {
		mmc0 = &sdhc_1;
		mmc1 = &sdhc_2;
		serial0 = &uart_0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	reserved-memory {
		ramoops@bfe80000 {
			compatible = "ramoops";
			reg = <0x0 0xbfe80000 0x0 0x80000>;
			console-size = <0x40000>;
			record-size = <0x2000>;
			pmsg-size = <0x0>;
			ftrace-size = <0x0>;
			dump-size = <0x3e000>;
		};
	};

	battery: battery {
		compatible = "simple-battery";
		voltage-min-design-microvolt = <3400000>;
		voltage-max-design-microvolt = <4390000>;
		energy-full-design-microwatt-hours = <11400000>;
		charge-full-design-microamp-hours = <3000000>;

		ocv-capacity-celsius = <25>;
		ocv-capacity-table-0 = <4370000 100>, <4337400 98>, <4307400 96>,
			<4280600 94>, <4256600 92>, <4233100 90>, <4209700 88>,
			<4186700 86>, <4164000 84>, <4141700 82>, <4120000 80>,
			<4099000 78>, <4078600 76>, <4058700 74>, <4039300 72>,
			<4021400 70>, <4006000 68>, <3990500 66>, <3971300 64>,
			<3949500 62>, <3927700 60>, <3905200 58>, <3884600 56>,
			<3868200 54>, <3854000 52>, <3841600 50>, <3830500 48>,
			<3820400 46>, <3811100 44>, <3802400 42>, <3795100 40>,
			<3788600 38>, <3783000 36>, <3778200 34>, <3774000 32>,
			<3769900 30>, <3765800 28>, <3761300 26>, <3755300 24>,
			<3748200 22>, <3739400 20>, <3728100 18>, <3715600 16>,
			<3701200 14>, <3686100 12>, <3680100 10>, <3678200 9>,
			<3676900 8>, <3673600 7>, <3667900 6>, <3650200 5>,
			<3610600 4>, <3555200 3>, <3481300 2>, <3374500 1>,
			<3193600 0>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		key-volume-up {
			label = "volume_up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&tlmm 85 GPIO_ACTIVE_LOW>;
		};
	};

	/* Dummy regulator until PMI632 has LCDB VSP/VSN support */
	lcdb_dummy: regulator-lcdb-dummy {
		compatible = "regulator-fixed";
		regulator-name = "lcdb_dummy";
		regulator-min-microvolt = <5500000>;
		regulator-max-microvolt = <5500000>;
	};

	vph_pwr: vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-always-on;
		regulator-boot-on;
	};

	/* Camera IOVDD, active-high enable on GPIO 130, shared by both cameras */
	cam_vio: cam-vio-regulator {
		compatible = "regulator-fixed";
		regulator-name = "cam_vio";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&tlmm 130 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <10000>;
		regulator-always-on;
	};

	/* Rear camera AF actuator supply, active-high enable on GPIO 128 */
	cam_vaf: cam-vaf-regulator {
		compatible = "regulator-fixed";
		regulator-name = "cam_vaf";
		regulator-min-microvolt = <2850000>;
		regulator-max-microvolt = <2850000>;
		gpio = <&tlmm 128 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <10000>;
	};

	/* Front camera DVDD, active-high enable on GPIO 46 */
	cam_vdig_front: cam-vdig-front-regulator {
		compatible = "regulator-fixed";
		regulator-name = "cam_vdig_front";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		gpio = <&tlmm 46 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <200>;
	};

	divclk2_codec: divclk2 {
		compatible = "gpio-gate-clock";
		clocks = <&rpmcc RPM_SMD_DIV_CLK2>;
		#clock-cells = <0>;
		enable-gpios = <&pm8953_gpios 1 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&tasha_mclk_default>;
	};

	/*
	 * External LDO feeding the WCD9335 SIDO buck input plus vdd-tx-h /
	 * vdd-rx-h / vdd-px (1.8 V, up to 650 mA combined), matching
	 * downstream's eldo2_8953. Taking vdd-buck from pm8953_l5 instead
	 * leaves the SIDO unable to start on its 5 mA budget, and the analog
	 * block then silently refuses writes and reads back zero.
	 */
	eldo2_8953: regulator-eldo2-8953 {
		compatible = "regulator-fixed";
		regulator-name = "eldo2_8953";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&tlmm 50 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
		pinctrl-names = "default";
		pinctrl-0 = <&codec_eldo2_en>;
	};

	/*
	 * The swappable modules.  Each slot lists only what is soldered to
	 * the mainboard — the bus the module hangs off, its rails, its
	 * reference clock and its enable line.  What is plugged in is
	 * worked out at boot; see drivers/misc/fp3_module_slot.c.
	 *
	 * enable-gpios is declared active-high so the slot driver works in
	 * raw levels: every module runs with its pin physically high, but
	 * the bindings disagree about how to say so — the camera sensors
	 * and the AW8898 call it an active-low reset, the TAS2557 calls the
	 * very same pin an active-high shutdown.
	 */
	module-slots {
		compatible = "fairphone,fp3-module-slots";

		slot-rear-camera {
			fairphone,slot = "rear-camera";
			i2c-bus = <&cci_i2c0>;

			clocks = <&gcc GCC_CAMSS_MCLK0_CLK>;
			enable-gpios = <&tlmm 40 GPIO_ACTIVE_HIGH>;

			vana-supply = <&pm8953_l22>;
			vdig-supply = <&pm8953_l2>;
			vif-supply = <&cam_vio>;
		};

		slot-front-camera {
			fairphone,slot = "front-camera";
			i2c-bus = <&cci_i2c1>;

			clocks = <&gcc GCC_CAMSS_MCLK1_CLK>;
			enable-gpios = <&tlmm 129 GPIO_ACTIVE_HIGH>;

			vana-supply = <&pm8953_l22>;
			vdig-supply = <&cam_vdig_front>;
			vif-supply = <&cam_vio>;
		};

		slot-speaker-amp {
			fairphone,slot = "speaker-amp";
			i2c-bus = <&i2c_6>;

			enable-gpios = <&tlmm 21 GPIO_ACTIVE_HIGH>;

			dvdd-supply = <&pm8953_l5>;
			vddio-supply = <&pm8953_l5>;
			vdd-supply = <&vph_pwr>;
		};
	};
};

&gpu {
	status = "okay";
};

&gpu_zap_shader {
	firmware-name = "qcom/msm8953/fairphone/fp3/a506_zap.mbn";
};

&hsusb_phy {
	vdd-supply = <&pm8953_l3>;
	vdda-pll-supply = <&pm8953_l7>;
	vdda-phy-dpdm-supply = <&pm8953_l13>;

	status = "okay";
};

&i2c_3 {
	status = "okay";

	touchscreen@48 {
		compatible = "himax,hx83112b";
		reg = <0x48>;
		interrupt-parent = <&tlmm>;
		interrupts = <65 IRQ_TYPE_LEVEL_LOW>;
		touchscreen-size-x = <1080>;
		touchscreen-size-y = <2160>;
		reset-gpios = <&tlmm 64 GPIO_ACTIVE_LOW>;
	};
};

&i2c_5 {
	status = "okay";

	nfc@28 {
		compatible = "nxp,nq310", "nxp,nxp-nci-i2c";
		reg = <0x28>;

		interrupt-parent = <&tlmm>;
		interrupts = <17 IRQ_TYPE_LEVEL_HIGH>;

		enable-gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
		firmware-gpios = <&tlmm 62 GPIO_ACTIVE_HIGH>;
	};
};

&i2c_6 {
	/*
	 * The amplifier node itself comes from the speaker slot overlay, but
	 * the bus properties have to be here: the slot driver talks to this
	 * bus to work out which amplifier is fitted, long before any overlay
	 * is applied.
	 */
	status = "okay";
	clock-frequency = <400000>;
};

/*
 * Keep blsp_i2c6 muxed to the I2C function while asleep.  Letting the pins
 * fall back to GPIO mode kills communication with the TAS2557.
 */
&i2c_6_sleep {
	function = "blsp_i2c6";
};

&slim_msm {
	status = "okay";

	slim@1 {
		reg = <1>;
		#address-cells = <2>;
		#size-cells = <0>;

		tasha_ifd: tas-ifd@0,0 {
			compatible = "slim217,1a0";
			reg = <0 0>;
		};

		wcd9335: codec@1,0 {
			compatible = "slim217,1a0";
			reg = <1 0>;

			clock-names = "mclk", "slimbus";
			clocks = <&divclk2_codec>,
				 <&rpmcc RPM_SMD_BB_CLK1>;

			interrupt-parent = <&tlmm>;
			interrupts = <73 IRQ_TYPE_LEVEL_HIGH>,
				     <73 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "intr1", "intr2";
			interrupt-controller;
			#interrupt-cells = <1>;

			pinctrl-0 = <&wcd_reset_active &wcd_intr_default>;
			pinctrl-names = "default";

			reset-gpios = <&tlmm 67 GPIO_ACTIVE_LOW>;
			slim-ifc-dev = <&tasha_ifd>;

			#sound-dai-cells = <1>;

			vdd-buck-supply = <&eldo2_8953>;
			vdd-buck-sido-supply = <&eldo2_8953>;
			vdd-rx-supply = <&eldo2_8953>;
			vdd-tx-supply = <&eldo2_8953>;
			vdd-io-supply = <&pm8953_l5>;
			vdd-vbat-supply = <&vph_pwr>;
			vdd-micbias-supply = <&pm8953_l13>;
		};
	};
};

/*
 * The LPASS internal digital codec defaults to okay in msm8953.dtsi, but
 * neither Fairphone 3 model uses it: audio goes out over SLIMbus to the
 * WCD9335 and over Quinary MI2S to the loudspeaker amplifier. Probing it
 * does clk_prepare_enable(mclk), which sends an AFE_SVC_CMD_SET_PARAM for
 * LPASS_CLK_ID_INTERNAL_DIGITAL_CODEC_CORE; the ADSP acks and then throws
 * "Excep:0:Exception detected" about two seconds later, leaving the
 * slim-NGD MCAP handshake permanently stuck.
 */
&lpass_codec {
	status = "disabled";
};

&lpass {
	firmware-name = "qcom/msm8953/fairphone/fp3/adsp.mbn";

	status = "okay";
};

&mdss {
	status = "okay";
};

&mdss_dsi0 {
	vdda-supply = <&pm8953_s3>;
	status = "okay";

	panel@0 {
		compatible = "djn,98-03057-6598b-i";
		reg = <0>;

		reset-gpios = <&tlmm 61 GPIO_ACTIVE_LOW>;

		iovcc-supply = <&pm8953_l6>;
		vsn-supply = <&lcdb_dummy>;
		vsp-supply = <&lcdb_dummy>;

		pinctrl-0 = <&mdss_te_default>;
		pinctrl-names = "default";

		port {
			panel_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	data-lanes = <0 1 2 3>;
	remote-endpoint = <&panel_in>;
};

&mdss_dsi0_phy {
	vcca-supply = <&pm8953_l3>;
	status = "okay";
};

&mpss {
	firmware-name = "qcom/msm8953/fairphone/fp3/mba.mbn",
			"qcom/msm8953/fairphone/fp3/modem.mbn";
	pll-supply = <&pm8953_l7>;

	status = "okay";
};

&pm8953_resin {
	linux,code = <KEY_VOLUMEDOWN>;
	status = "okay";
};

&pmi632_lpg {
	status = "okay";

	multi-led {
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_STATUS;

		#address-cells = <1>;
		#size-cells = <0>;

		led@1 {
			reg = <1>;
			color = <LED_COLOR_ID_RED>;
		};

		led@2 {
			reg = <2>;
			color = <LED_COLOR_ID_GREEN>;
		};

		led@3 {
			reg = <3>;
			color = <LED_COLOR_ID_BLUE>;
		};
	};
};

&pmi632_typec {
	status = "okay";

	connector {
		compatible = "usb-c-connector";

		power-role = "dual";
		data-role = "dual";
		self-powered;

		typec-power-opmode = "default";
		pd-disable;

		port {
			pmi632_hs_in: endpoint {
				remote-endpoint = <&usb_dwc3_hs>;
			};
		};
	};
};

&pmi632_vbus {
	regulator-min-microamp = <500000>;
	regulator-max-microamp = <1000000>;
	status = "okay";
};

&pmi632_vib {
	status = "okay";
};

&pmi632_adc {
	channel@4a {
		reg = <ADC5_BAT_THERM_100K_PU>;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
		qcom,ratiometric;
		label = "batt_therm";
	};
};

&pmi632_qg {
	monitored-battery = <&battery>;
	power-supplies = <&pmi632_charger>;
	io-channels = <&pmi632_adc ADC5_BAT_THERM_100K_PU>;
	io-channel-names = "batt-therm";
	status = "okay";
};

&pmi632_charger {
	monitored-battery = <&battery>;
	status = "okay";
};

&q6afedai {
	dai@127 {
		reg = <QUINARY_MI2S_RX>;
		qcom,sd-lines = <0 1>;
	};
};

&sdhc_1 {
	vmmc-supply = <&pm8953_l8>;
	vqmmc-supply = <&pm8953_l5>;

	status = "okay";
};

&sdhc_2 {
	vmmc-supply = <&pm8953_l11>;
	vqmmc-supply = <&pm8953_l12>;

	cd-gpios = <&tlmm 133 GPIO_ACTIVE_LOW>;

	status = "okay";
};

&sound_card {
	pinctrl-0 = <&quin_mi2s_active>, <&quin_mi2s_ws_active>;
	pinctrl-1 = <&quin_mi2s_sleep>, <&quin_mi2s_ws_sleep>;
	pinctrl-names = "default",
			"sleep";

	/*
	 * Left disabled until a loudspeaker module has been identified; the
	 * speaker slot overlay supplies the codec and flips the status, so
	 * the card never probes against an amplifier that is not there.
	 */

	/*
	 * Only widgets that are certain to be present may appear here: since
	 * dd2395162c07 ("ASoC: remove disable_route_checks") a route naming a
	 * missing widget aborts the entire card. Both loudspeaker amplifiers
	 * expose "OUT", so this list is valid whichever one is fitted. The
	 * WCD9335 routes join it once that codec enumerates.
	 */
	/delete-property/ audio-routing;
	audio-routing = "Speaker", "OUT";
	widgets = "Speaker", "Speaker";
	pin-switches = "Speaker";

	/delete-node/ primary-mi2s-dai-link;
	/delete-node/ tertiary-mi2s-dai-link;

	/*
	 * No SLIM DAI link yet. The WCD9335 is described below and its driver
	 * loads, but the NGD satellite handshake still fails ("ADDR_QUERY:
	 * ADSP returned failed EA"), so the codec never enumerates. A link
	 * naming it would park the card in deferred probe for ever and take
	 * the loudspeaker with it, so earpiece playback stays out of tree
	 * until enumeration works.
	 */

	/*
	 * This link has to be declared here, after the MultiMedia links it
	 * shares a card with, and only its codec may come from an overlay.
	 *
	 * Every DAI link names q6routing as its platform, so q6routing's
	 * component — and with it the 528 DAPM routes referencing
	 * MM_DL1..8 — is probed alongside whichever link comes first. Those
	 * MM_DL widgets belong to q6asm, the CPU side of the MultiMedia
	 * links, so a MultiMedia link must be probed first or every one of
	 * those routes fails to resolve. Since ASoC dropped
	 * disable_route_checks (dd2395162c07) a failed component route is
	 * fatal and the card aborts with -ENODEV.
	 *
	 * of_changeset attaches overlay nodes at the *head* of the parent's
	 * child list, so a link contributed by an overlay always sorts
	 * first and drags q6routing ahead of q6asm. Declaring the node here
	 * pins its position; the overlay fills in the codec only.
	 */
	fp3_quinary_link: quinary-mi2s-dai-link {
		link-name = "Quinary MI2S";

		cpu {
			sound-dai = <&q6afedai QUINARY_MI2S_RX>;
		};

		platform {
			sound-dai = <&q6routing>;
		};
	};
};

&rpm_requests {
	regulators {
		compatible = "qcom,rpm-pm8953-regulators";

		vdd_l1-supply = <&pm8953_s3>;
		vdd_l2_l3-supply = <&pm8953_s3>;
		vdd_l4_l5_l6_l7_l16_l19-supply = <&pm8953_s4>;
		vdd_l8_l11_l12_l13_l14_l15-supply = <&vph_pwr>;
		vdd_l9_l10_l17_l18_l22-supply = <&vph_pwr>;

		pm8953_s3: s3 {
			regulator-min-microvolt = <984000>;
			regulator-max-microvolt = <1240000>;
		};

		pm8953_s4: s4 {
			regulator-min-microvolt = <1036000>;
			regulator-max-microvolt = <2040000>;
		};

		pm8953_s5: s5 {
			regulator-min-microvolt = <1036000>;
			regulator-max-microvolt = <2040000>;
		};

		pm8953_l1: l1 {
			regulator-min-microvolt = <975000>;
			regulator-max-microvolt = <1050000>;
		};

		pm8953_l2: l2 {
			regulator-min-microvolt = <975000>;
			regulator-max-microvolt = <1175000>;
		};

		pm8953_l3: l3 {
			regulator-min-microvolt = <925000>;
			regulator-max-microvolt = <925000>;
		};

		pm8953_l5: l5 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};

		pm8953_l6: l6 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};

		pm8953_l7: l7 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1900000>;
		};

		pm8953_l8: l8 {
			regulator-min-microvolt = <2900000>;
			regulator-max-microvolt = <2900000>;
		};

		pm8953_l9: l9 {
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3300000>;
		};

		pm8953_l10: l10 {
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <3000000>;
		};

		pm8953_l11: l11 {
			regulator-min-microvolt = <2950000>;
			regulator-max-microvolt = <2950000>;
		};

		pm8953_l12: l12 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <2950000>;
		};

		pm8953_l13: l13 {
			regulator-min-microvolt = <3125000>;
			regulator-max-microvolt = <3125000>;
		};

		pm8953_l16: l16 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};

		pm8953_l17: l17 {
			regulator-min-microvolt = <2850000>;
			regulator-max-microvolt = <2850000>;
		};

		pm8953_l19: l19 {
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1350000>;
		};

		pm8953_l22: l22 {
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2800000>;
		};

		pm8953_l23: l23 {
			regulator-min-microvolt = <975000>;
			regulator-max-microvolt = <1225000>;
		};
	};
};

&tlmm {
	/*
	 * 0-3: unused but protected by TZ
	 * 135-138: fingerprint reader (SPI)
	 */
	gpio-reserved-ranges = <0 4>, <135 4>;

	wcd_reset_active: wcd-reset-active-state {
		pins = "gpio67";
		function = "gpio";
		drive-strength = <16>;
		output-high;
	};

	wcd_intr_default: wcd-intr-default-state {
		pins = "gpio73";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	codec_eldo2_en: codec-eldo2-en-state {
		pins = "gpio50";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
		output-high;
	};

	mdss_te_default: mdss-te-default-state {
		pins = "gpio24";
		function = "mdp_vsync";
		drive-strength = <2>;
		bias-pull-down;
	};

	quin_mi2s_active: quin-mi2s-active-state {
		pins = "gpio88", "gpio91", "gpio93";
		function = "pri_mi2s";
		drive-strength = <8>;
	};

	quin_mi2s_sleep: quin-mi2s-sleep-state {
		pins = "gpio88", "gpio91", "gpio93";
		function = "pri_mi2s";
		drive-strength = <2>;
		bias-pull-down;
	};

	quin_mi2s_ws_active: quin-mi2s-ws-active-state {
		pins = "gpio92";
		function = "pri_mi2s_ws";
		drive-strength = <8>;
	};

	quin_mi2s_ws_sleep: quin-mi2s-ws-sleep-state {
		pins = "gpio92";
		function = "pri_mi2s_ws";
		drive-strength = <2>;
		bias-pull-down;
	};
};

&uart_0 {
	status = "okay";
};

&usb3 {
	status = "okay";
};

&usb_dwc3_hs {
	remote-endpoint = <&pmi632_hs_in>;
};

&wcnss {
	firmware-name = "qcom/msm8953/fairphone/fp3/wcnss.mbn";
	vddpx-supply = <&pm8953_l5>;

	status = "okay";
};

&wcnss_ctrl {
	firmware-name = "qcom/msm8953/fairphone/fp3/WCNSS_qcom_wlan_nv.bin";
};

&wcnss_iris {
	compatible = "qcom,wcn3680";

	vddxo-supply = <&pm8953_l7>;
	vddrfa-supply = <&pm8953_l19>;
	vddpa-supply = <&pm8953_l9>;
	vdddig-supply = <&pm8953_l5>;
};

/* Camera subsystem — see module-slots above */

&camss {
	vdda-supply = <&pm8953_s3>;

	/*
	 * Left disabled, and with no ports. camss_of_parse_ports() waits on
	 * every endpoint's remote subdev, so an endpoint whose sensor is not
	 * fitted would stall the notifier and kill the other camera too.
	 * Each camera slot overlay contributes its own port; the last one
	 * enables CAMSS.
	 */
};

&cci {
	pinctrl-names = "default";
	pinctrl-0 = <&cci0_default>,
		    <&cci1_default>,
		    <&camss_mclk0_default>,
		    <&camss_mclk1_default>;

	status = "okay";
};

&pm8953_gpios {
	tasha_mclk_default: tasha-mclk-default-state {
		pins = "gpio1";
		function = "func1";
		bias-disable;
		power-source = <0>;
		qcom,drive-strength = <PMIC_GPIO_STRENGTH_LOW>;
	};
};
